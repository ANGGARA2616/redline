rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Usernames
    // Lookup-only collection: { uid: "..." }
    // Public can read (to check username availability before sign-up).
    // Only the matching authenticated user can create their own entry.
    // No update/delete from the client — prevents username hijacking.
    // ──────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // Users
    // Only the owner can read/write their full document.
    // Sensitive data (subscription, packages, email) stays private.
    // ──────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public-safe user lookup by username.
    // Cloud Functions or a dedicated publicProfiles collection can be used.
    // For MVP, we allow read on users ONLY from server-side calls via
    // Firebase Admin SDK (in API routes), which bypass security rules.
    // Client-side public queue will call a Next.js API route instead.

    // ──────────────────────────────────────────────
    // Sessions
    // Owner can CRUD. Public can read (for public queue page).
    // ──────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.streamerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.streamerId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // Queue Entries
    // Owner can CRUD. Public can read (for public queue page).
    // ──────────────────────────────────────────────
    match /queueEntries/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.streamerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.streamerId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // Game Logs
    // Owner can create and update (to set endedAt). Public can read.
    // ──────────────────────────────────────────────
    match /gameLogs/{logId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.streamerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.streamerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.streamerId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // Feedbacks
    // Authenticated users can create their own feedback.
    // No client-side read/update/delete — owner reads from Firebase Console.
    // ──────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
